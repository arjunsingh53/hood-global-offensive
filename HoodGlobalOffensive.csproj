<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- GUI subsystem: double-clicking the exe opens the game without a console
         window riding along. CLI modes (headless, screenshot, maps) still print
         to the launching terminal via inherited handles, with an AttachConsole
         fallback in Program.cs for launchers that pass none. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.2.2</Version>
    <Product>HOODMATCH</Product>
    <Description>Fast-movement arena FPS with dual grappling hooks and kill-point upgrades.</Description>
    <!-- Raylib-cs hands out vertex data as pointers; WeaponModels reads it to
         measure the muzzle from the mesh instead of hard-coding it. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Raylib-cs" Version="8.1.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Weapon meshes are read from disk at runtime, so they ship with the binaries. -->
    <None Update="assets/**/*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Unity project and its parity harness live in this repo but are built by
         the Unity editor and the parity project in tools/parity respectively. -->
    <Compile Remove="unity/**" />
    <None Remove="unity/**" />
    <Compile Remove="tools/**" />
    <None Remove="tools/**" />
  </ItemGroup>

</Project>
