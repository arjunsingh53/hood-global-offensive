# Normalise line endings on checkout/commit; the game ships on Windows.
* text=auto

*.cs      text diff=csharp
*.csproj  text
*.cmd     text eol=crlf
*.sh      text eol=lf

# Binary assets must never be line-ending converted.
*.png     binary
*.jpg     binary
*.wav     binary
*.exe     binary
*.dll     binary
*.glb     binary
*.gltf    binary
*.bin     binary

# Unity: serialised YAML is LF on every platform; treat as text, force LF
# so Windows checkouts never surface phantom-dirty scene/meta files.
*.meta       text eol=lf
*.unity      text eol=lf
*.prefab     text eol=lf
*.asset      text eol=lf
*.mat        text eol=lf
*.anim       text eol=lf
*.controller text eol=lf
*.asmdef     text eol=lf

# Keep generated screenshots out of language statistics.
shots/*.png linguist-documentation
